<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: Startbildschirm auch beim Start über ein activity-alias (wählbares App-Icon) im Bristol-Grün statt weiß.
         Gleiche Einträge wie AppTheme in values/styles.xml, ergänzt um die Farben des System-Startbildschirms. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
