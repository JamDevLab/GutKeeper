# Template for the file ".env" (for docker compose). Copy it: cp .env.example .env
# Every value is optional; empty or left out means the stated default.
# Credentials and passwords belong only in .env (listed in .gitignore), never in this template.

# ======== Used by the docker-compose.yml in the main folder ========

# Time zone (time in the backup file names). Default: Europe/Berlin
TZ=Europe/Berlin
# 1 = several accounts (name + password), 0 = one account (password only). Default: 0
# You set the password or the first account in the app on first start (one-time code in the server log).
MULTIUSER=0
# Default for "Log food": 1 = on, 0 = off (everyone can change it for themselves). Default: 0
FOOD_DEFAULT=0
# Connect the Android app (APK) or another web address to this server: allowed origin(s), comma-separated.
# For the APK: https://localhost. Empty = none
CORS_ORIGINS=
# Number of server backups kept. Default: 30
BACKUP_KEEP=30
# Password that encrypts the backups (AES-256, files *.db.enc.json). Empty = unencrypted
# If the value contains a $, put it in single quotes. Without this password the backups can no longer be opened.
BACKUP_PASSWORD=

# ======== More options: only with compose/all-options.yml (it also knows all of the above) ========

# ---- Container and network ----
# Image version from ghcr.io: 1 = always the latest 1.x, 1.2 = bug fixes only, 1.2.3 = fixed. Default: 1
IMAGE_TAG=1
# Port on the host. Default: 3000
HOST_PORT=3000
# Address the port listens on. 127.0.0.1 = reachable only through a reverse proxy. Default: 0.0.0.0
BIND_ADDR=0.0.0.0
# User and group ID the container runs as (owner of the folder ./data). Default: 1000
PUID=1000
PGID=1000

# ---- Appearance ----
# Own app name (title, lock screen). Empty = GutKeeper
APP_NAME=
# App icon: bristol, ring, guard, crest, classic, shield, list, diary (or 1 to 8) or custom (own file, see docs/CONFIGURATION.md). Default: bristol
APP_ICON=bristol
# Splash screen color as #RRGGBB. Empty = matches the icon
APP_THEME_COLOR=

# ---- Accounts and sign-in ----
# 1 = admin may use server backups and the full export, 0 = manage accounts only. Default: 1
# Note: even with 0 an admin can reset passwords. Real separation: end-to-end encryption or separate containers.
ADMIN_FULL_ACCESS=1
# Fixed key for the sign-in cookies (e.g. with several instances). Empty = file data/session.key
# If the value contains a $, put it in single quotes, e.g. 'ab$cd'
SESSION_SECRET=

# ---- Features ----
# Guided first-run dialog after the first sign-in (once per account and device), 0 = off. Default: 1
ONBOARDING=1
# Months a device stores locally (older ones are loaded from the server when needed), 0 = all. Default: 12
LOCAL_MONTHS=12

# ---- Reverse proxy and access ----
# 1 = behind a reverse proxy (real client IP from X-Real-IP, detect HTTPS). Default: 0
TRUST_PROXY=0
# Must be set with TRUST_PROXY=1: IP addresses or networks (CIDR) of the proxy, comma-separated, e.g. 172.18.0.0/16
# Empty = any private address; then every device on the home network can fake its IP.
TRUSTED_PROXY=
# Allowed host names (protection against DNS rebinding), comma-separated, e.g. gutkeeper.example.org. Empty = any name
ALLOWED_HOSTS=
# Send the cookie over HTTPS only: auto (detects HTTPS), 1 = always, 0 = never. Default: auto
COOKIE_SECURE=auto

# ---- Server backups ----
# Hours between two backups. Default: 24
BACKUP_INTERVAL_HOURS=24
# Another folder on the host for the backups (e.g. a second disk on a NAS). Default: ./data/backups
BACKUP_HOST_DIR=./data/backups
